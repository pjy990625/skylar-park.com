{
  "$schema": "https://schemas.wp.org/wp/6.9/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        { "slug": "base", "name": "Base", "color": "#ffffff" },
        { "slug": "surface", "name": "Surface", "color": "#f3f4f6" },
        { "slug": "contrast", "name": "Contrast", "color": "#111827" },
        { "slug": "muted", "name": "Muted", "color": "#4b5563" },
        { "slug": "primary", "name": "Primary", "color": "#1d4ed8" },
        { "slug": "primary-dark", "name": "Primary Dark", "color": "#1e3a8a" }
      ]
    },
    "spacing": {
      "units": [ "px", "em", "rem", "%", "vw", "vh" ],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "20", "name": "XS", "size": "0.5rem" },
        { "slug": "30", "name": "S", "size": "1rem" },
        { "slug": "40", "name": "M", "size": "clamp(1.5rem, 3vw, 2rem)" },
        { "slug": "50", "name": "L", "size": "clamp(2rem, 5vw, 3.5rem)" },
        { "slug": "60", "name": "XL", "size": "clamp(3rem, 8vw, 6rem)" }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "system-sans",
          "name": "System Sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
        },
        {
          "slug": "system-mono",
          "name": "System Mono",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
        { "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
        { "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.375rem" } },
        { "slug": "x-large", "name": "Extra Large", "size": "2rem", "fluid": { "min": "1.625rem", "max": "2rem" } },
        { "slug": "xx-large", "name": "Huge", "size": "3.25rem", "fluid": { "min": "2.25rem", "max": "3.25rem" } }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "top": "0",
        "right": "var(--wp--preset--spacing--40)",
        "bottom": "0",
        "left": "var(--wp--preset--spacing--40)"
      }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system-sans)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "700",
          "lineHeight": "1.2",
          "letterSpacing": "-0.01em"
        }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
      "link": {
        "color": { "text": "var(--wp--preset--color--primary)" },
        "typography": { "textDecoration": "underline" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--primary-dark)" }
        },
        ":focus-visible": {
          "outline": {
            "color": "var(--wp--preset--color--primary)",
            "style": "solid",
            "width": "2px",
            "offset": "2px"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--base)"
        },
        "border": { "radius": "6px" },
        "typography": { "fontWeight": "600" },
        ":hover": {
          "color": { "background": "var(--wp--preset--color--primary-dark)" }
        },
        ":focus-visible": {
          "outline": {
            "color": "var(--wp--preset--color--contrast)",
            "style": "solid",
            "width": "2px",
            "offset": "2px"
          }
        }
      },
      "code": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--system-mono)" }
      }
    },
    "blocks": {
      "core/site-title": {
        "typography": { "fontWeight": "700", "fontSize": "var(--wp--preset--font-size--medium)" },
        "elements": {
          "link": {
            "color": { "text": "var(--wp--preset--color--contrast)" },
            "typography": { "textDecoration": "none" }
          }
        }
      },
      "core/navigation": {
        "elements": {
          "link": { "typography": { "textDecoration": "none" } }
        }
      },
      "core/post-terms": {
        "typography": { "fontSize": "var(--wp--preset--font-size--small)" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-no-title", "title": "Page (No Title)", "postTypes": [ "page" ] }
  ]
}
