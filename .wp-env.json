{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": null,
  "phpVersion": "8.3",
  "themes": [ "./themes/skylar-park" ],
  "mappings": {
    "wp-content/mu-plugins": "./mu-plugins"
  },
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": true,
    "SCRIPT_DEBUG": true,
    "WP_ENVIRONMENT_TYPE": "local"
  },
  "lifecycleScripts": {
    "afterStart": "wp-env run cli wp theme activate skylar-park && wp-env run cli wp rewrite structure /%postname%/ && wp-env run cli wp rewrite flush"
  }
}
